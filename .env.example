# --- Network -------------------------------------------------------------
# Bind to loopback only. Caddy terminates TLS and proxies to this address.
HOST=127.0.0.1
PORT=8087

# Number of reverse proxies in front of the app. Needed so rate limiting sees
# the real client IP from X-Forwarded-For instead of the proxy IP.
TRUST_PROXY_HOPS=1

# --- Authentication ------------------------------------------------------
# Full access: portfolio endpoints, price lookups, admin actions.
# Generate with: openssl rand -hex 32
ADMIN_KEY=

# Guest keys may only value a public inventory. Format: key:label,key:label
# Give every person their own key so you can revoke one without touching others.
GUEST_KEYS=

# --- Web frontend sessions -----------------------------------------------
# The browser frontend cannot hold a bearer key, because anything it stores is
# readable by script on the page. Instead a person types an access code once and
# receives an HttpOnly cookie. Format: code:label,code:label
#
# Twelve characters minimum: these are meant to be typed, so they are shorter
# than the guest keys and the login endpoint is rate limited hard to compensate.
# Leave empty to disable the login endpoints entirely.
ACCESS_CODES=

# Signing key for those cookies. Required as soon as ACCESS_CODES is set, at
# least 32 characters. Generate with: openssl rand -hex 32
# Rotating this value signs everybody out at once - that is the only revocation
# lever, since the cookies carry their own expiry rather than a database row.
SESSION_SECRET=

# Cookie lifetime and name.
SESSION_TTL_DAYS=30
COOKIE_NAME=sxo_session

# Set to false only for local development over plain http. Anything reachable
# from outside must leave this on.
COOKIE_SECURE=true

# Guards the login endpoint, keyed on client address. This is the one place a
# short secret is guessed against, so keep it tight.
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX=10

# Budget for a signed-in browser. Larger than the guest limit because loading a
# library plus polling for completion times is many small requests.
SESSION_RATE_WINDOW_MINUTES=10
SESSION_RATE_MAX=120

# --- Storage -------------------------------------------------------------
DATA_DIR=./data

# --- Pricing -------------------------------------------------------------
# Output currency. EUR and USD are supported. Steam returns the requested
# currency directly, so no conversion happens anywhere.
CURRENCY=EUR

# How often the background refresh cycle runs, in minutes.
PRICE_REFRESH_MINUTES=60

# A price older than this is queued for refresh and reported as stale.
PRICE_MAX_AGE_HOURS=12

# Upper bound on Steam lookups per cycle. At the delay below, 150 lookups take
# roughly ten minutes.
PRICE_REFRESH_BATCH=150

# A name failing this often in a row drops out of the refresh queue. Items with
# no market listing at all would otherwise be retried forever.
MAX_LOOKUP_FAILURES=5

# Names nobody has asked about for this long are forgotten.
TRACKED_RETENTION_DAYS=30

# One price history row per item is kept at most every N hours.
HISTORY_INTERVAL_HOURS=24
ENABLE_HISTORY=true

# Steam keeps roughly 15% of a market sale. Net proceeds = price / this value.
STEAM_FEE_DIVISOR=1.15

# --- Steam lookups -------------------------------------------------------
# Every price comes from steamcommunity.com/market/priceoverview, serialised
# with this delay. Steam blocks the server IP for ~5 minutes after a burst.
STEAM_FALLBACK_ENABLED=true
STEAM_FALLBACK_DELAY_MS=4000
# Maximum number of lookups a single incoming request may trigger.
STEAM_FALLBACK_MAX_PER_REQUEST=15

# Steam answers 429 to clients it does not recognise, so requests present a
# consistent browser identity. These two belong together: the client hint has
# to name the same major version as the user agent, otherwise the pair looks
# forged. Bump both when Steam starts refusing this combination.
STEAM_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
STEAM_SEC_CH_UA="Chromium";v="124", "Google Chrome";v="124"

# --- Inventory -----------------------------------------------------------
# A fetched inventory is reused for this long before Steam is contacted again.
INVENTORY_CACHE_MINUTES=10

# Items per inventory page. Steam scales its rate limit with this value, so
# this stays close to what the community site itself requests.
INVENTORY_PAGE_SIZE=75

# Safety limit on pagination: page size times this is the item ceiling.
INVENTORY_MAX_PAGES=40

# Pause between inventory pages, so paging does not look like a burst.
INVENTORY_PAGE_DELAY_MS=2000

# --- Steam library -------------------------------------------------------
# Steam Web API key, from https://steamcommunity.com/dev/apikey
# Needed for the library endpoints: resolving a vanity name, reading a profile
# and listing owned games all require it. Leave empty and those endpoints answer
# 503 while everything else keeps working, so an existing deployment still boots
# after an update without new configuration.
STEAM_API_KEY=

# A library changes far less often than a price.
LIBRARY_CACHE_MINUTES=60
PROFILE_CACHE_MINUTES=60
VANITY_CACHE_HOURS=24

# Base URL for capsule images. Configurable because Steam has moved this host
# before and a broken image should not need a redeploy.
STEAM_CAPSULE_BASE=https://shared.fastly.steamstatic.com/store_item_assets/steam/apps

# --- Store tags ----------------------------------------------------------
# Steam's user tags ("Metroidvania", "Soulslike") come from the undocumented API
# the store front-end itself calls. No API key is involved. Set to false to stop
# all outbound traffic there; libraries still load, just with empty tag lists.
STORE_TAGS_ENABLED=true

# Tag names are localised and cached per language. Changing this refetches the
# vocabulary on the next library load; the per-game tag IDs stay valid.
STORE_TAG_LANGUAGE=german
STORE_TAG_COUNTRY=DE

# Top N tags per game, in Steam's own order (most agreed-upon first).
STORE_TAGS_PER_GAME=6

# AppIDs per request. The request is a JSON blob in a query parameter, so the
# real limit is URL length rather than a documented item count: 240 still
# answers, 300 comes back 414 URI Too Long. Do not raise this past 240.
STORE_TAG_BATCH_SIZE=200

# Tags drift slowly - a game does not change genre - so they are refreshed
# rarely, and so is the tag vocabulary itself.
STORE_TAG_MAX_AGE_DAYS=30
STORE_TAG_LIST_MAX_AGE_DAYS=30

# Wall clock budget for filling tags during one library request. Tags are never
# worth making somebody wait: whatever misses the budget stays uncached and is
# picked up on the next load. A 500-game library needs roughly 1.5s of it.
STORE_TAG_BUDGET_MS=8000

# --- HowLongToBeat -------------------------------------------------------
# HowLongToBeat has no public API, so this scrapes the endpoints their own web
# app uses. Set to false to stop all outbound traffic to them; libraries still
# load, just without completion times.
HLTB_ENABLED=true

# The background worker resolves this many games per cycle. Batch size times
# delay should stay under the interval, otherwise cycles overlap and the guard
# in hltb.ts simply skips the extra run.
HLTB_WORKER_INTERVAL_MINUTES=2
HLTB_BATCH_SIZE=40
HLTB_DELAY_MS=3000

# Completion times are effectively static, so they are refreshed rarely. A game
# with no match is retried sooner, because their database keeps growing.
HLTB_MAX_AGE_DAYS=90
HLTB_UNMATCHED_RETRY_DAYS=30

# How long a discovered search token is reused before a new one is fetched.
HLTB_TOKEN_TTL_MINUTES=30

# --- Rate limiting -------------------------------------------------------
# Per client address, applied before authentication so that wrong keys and the
# open health endpoint are bounded too. IPv6 clients are bucketed per /64.
# Keep this above the per key limits below.
IP_RATE_WINDOW_MINUTES=10
IP_RATE_MAX=300

# Applies per API key, after authentication.
GUEST_RATE_WINDOW_MINUTES=10
GUEST_RATE_MAX=20
ADMIN_RATE_WINDOW_MINUTES=10
ADMIN_RATE_MAX=200
