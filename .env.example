# --- Network -------------------------------------------------------------
# Bind to loopback only. Caddy terminates TLS and proxies to this address.
HOST=127.0.0.1
PORT=8087

# Number of reverse proxies in front of the app. Needed so rate limiting sees
# the real client IP from X-Forwarded-For instead of the proxy IP.
TRUST_PROXY_HOPS=1

# --- Authentication ------------------------------------------------------
# Full access: portfolio endpoints, price lookups, admin actions.
# Generate with: openssl rand -hex 32
ADMIN_KEY=

# Guest keys may only value a public inventory. Format: key:label,key:label
# Give every person their own key so you can revoke one without touching others.
GUEST_KEYS=

# --- Storage -------------------------------------------------------------
DATA_DIR=./data

# --- Pricing -------------------------------------------------------------
# Output currency. EUR and USD are supported.
CURRENCY=EUR

# How often the bulk price dump is pulled, in minutes. The dump itself is
# regenerated once a day, so anything below a few hours only wastes bandwidth.
PRICE_REFRESH_MINUTES=360

# Prices older than this are still served but flagged as stale in the response.
# Keep it above the refresh interval, otherwise a healthy cache is flagged
# during normal operation. Roughly two missed refresh cycles is a good value.
PRICE_STALE_MINUTES=720

# One price history row per item is kept at most every N hours.
HISTORY_INTERVAL_HOURS=24
# Set to false to disable history recording entirely.
ENABLE_HISTORY=true

# Steam keeps roughly 15% of a market sale. Net proceeds = price / this value.
STEAM_FEE_DIVISOR=1.15

# Fallback USD->EUR rate, used only if the exchange rate API is unreachable.
USD_TO_EUR_FALLBACK=0.92

# --- Steam market fallback ----------------------------------------------
# For items missing from the bulk dump, query Steam directly. Heavily
# throttled: Steam blocks the server IP for ~5 minutes after a burst.
STEAM_FALLBACK_ENABLED=true
STEAM_FALLBACK_DELAY_MS=4000
# Maximum number of direct Steam lookups triggered by a single request.
STEAM_FALLBACK_MAX_PER_REQUEST=15

# --- Inventory -----------------------------------------------------------
# A fetched inventory is reused for this long before Steam is contacted again.
INVENTORY_CACHE_MINUTES=10

# Safety limit on inventory pagination (2000 items per page).
INVENTORY_MAX_PAGES=5

# --- Rate limiting -------------------------------------------------------
# Per client address, applied before authentication so that wrong keys and the
# open health endpoint are bounded too. IPv6 clients are bucketed per /64.
# Keep this above the per key limits below.
IP_RATE_WINDOW_MINUTES=10
IP_RATE_MAX=300

# Applies per API key, after authentication.
GUEST_RATE_WINDOW_MINUTES=10
GUEST_RATE_MAX=20
ADMIN_RATE_WINDOW_MINUTES=10
ADMIN_RATE_MAX=200
